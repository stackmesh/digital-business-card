# Copy to .env before local commands or `docker compose up --build`.
# These are local defaults, not production secrets. Compose does not bake them
# into the image. The API container uses host `postgres` and NODE_ENV=production.
NODE_ENV=development
PORT=3000

POSTGRES_USER=business_card
POSTGRES_PASSWORD=business_card
POSTGRES_DB=business_card

# Host-side Prisma commands. Compose publishes Postgres on localhost:5433.
# The API container uses host `postgres` and port 5432 on the Compose network.
DATABASE_URL=postgresql://business_card:business_card@localhost:5433/business_card?schema=public

# Optional seed file. When unset, prisma/seed-data/profile.local.json is used
# if it exists. Otherwise the example template is seeded and is not real
# profile information. The API does not seed on startup.
# SEED_DATA_PATH=
