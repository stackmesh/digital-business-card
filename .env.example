# Local development. Copy to .env. Do not put production secrets here.
NODE_ENV=development
PORT=3000

# Matches the PostgreSQL service in docker-compose.yml when the API runs on the host.
DATABASE_URL=postgresql://business_card:business_card@localhost:5432/business_card?schema=public

# Optional seed file. When unset, prisma/seed-data/profile.local.json is used
# if it exists. Otherwise the example template is seeded and is not real
# profile information. The API does not seed on startup.
# SEED_DATA_PATH=
